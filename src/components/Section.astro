---
import SectionLabel from './SectionLabel.astro';
import type { SectionId } from '../data/types';
import type { Locale } from '../lib/i18n';

interface Props {
  id: SectionId;
  lang: Locale;
  /** Show the two-digit number before the label (home page). */
  numbered?: boolean;
  /** Replaces the section's usual label, e.g. "Profile" for About on the CV. */
  label?: string;
}

const { id, lang, numbered = true, label } = Astro.props;

// Short sections print whole, heading included. Longer ones put a printed copy
// of their heading into their first item (see SectionLabel), so in print a
// heading never ends a page without its first entry, in every browser.
const PRINT_WHOLE: readonly SectionId[] = ['about', 'affiliations', 'skills', 'contact'];
---

<section id={id} class:list={['section', 'reveal', { 'section--whole': PRINT_WHOLE.includes(id) }]} aria-labelledby={`${id}-label`}>
  <div class="container grid">
    <SectionLabel id={id} lang={lang} numbered={numbered} label={label} />
    <div class="section__body">
      <slot />
    </div>
  </div>
</section>
