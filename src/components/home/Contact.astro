---
import { EMAIL, PROFILE_LINKS } from '../../data/shared';
import { getProfile, type Locale } from '../../lib/i18n';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = getProfile(lang);
---

<div class="contact">
  {t.contact.showAvailability && <p class="contact__availability measure">{t.contact.availability}</p>}
  <dl class="pair contact__list">
    <div>
      <dt class="subhead">{t.contact.emailLabel}</dt>
      <dd class="contact__value">
        {/* The address is assembled by src/scripts/email.ts; it never appears whole in the HTML. */}
        <span class="contact__email" data-email-user={EMAIL.user} data-email-domain={EMAIL.domain}>
          <noscript>{`${EMAIL.user} ${t.contact.emailAt} ${EMAIL.domain}`}</noscript>
        </span>
      </dd>
    </div>
    <div>
      <dt class="subhead">{t.contact.profilesLabel}</dt>
      <dd class="contact__value">
        <ul class="contact__profiles" role="list">
          {
            PROFILE_LINKS.map((link) => (
              <li>
                <a class="tap-link" href={link.href} rel="noopener noreferrer" data-profile={link.id}>
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </dd>
    </div>
  </dl>
</div>

<script>
  import { initEmail } from '../../scripts/email';

  initEmail();
</script>

<style>
  .contact__availability {
    margin-block-end: var(--space-l);
    font-size: var(--step-1);
  }

  .contact__list .subhead {
    margin-block-end: var(--space-2xs);
  }

  .contact__value {
    margin: 0;
  }

  /* Holds the line before the script adds the link, so nothing shifts */
  .contact__email {
    display: flex;
    align-items: center;
    min-height: var(--tap);
    font-size: var(--step-1);
    overflow-wrap: anywhere;
  }

  .contact__profiles {
    display: flex;
    flex-wrap: wrap;
    column-gap: var(--space-l);
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: var(--step-1);
  }
</style>
