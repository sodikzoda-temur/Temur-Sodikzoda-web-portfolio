---
import EmailLink from '../EmailLink.astro';
import ProfileLinks from '../ProfileLinks.astro';
import ContactQr from '../ContactQr.astro';
import SaveContact from '../SaveContact.astro';
import { getProfile, type Locale } from '../../lib/i18n';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = getProfile(lang);
---

<div class="contact">
  {t.contact.showAvailability && <p class="contact__availability measure">{t.contact.availability}</p>}
  <dl class="pair contact__list">
    <div>
      <dt class="subhead">{t.contact.emailLabel}</dt>
      <dd class="contact__value">
        <EmailLink lang={lang} />
      </dd>
    </div>
    <div>
      <dt class="subhead">{t.contact.profilesLabel}</dt>
      <dd class="contact__value">
        <ProfileLinks />
      </dd>
    </div>
  </dl>
  <div class="contact__card">
    <SaveContact lang={lang} />
    <ContactQr lang={lang} />
  </div>
</div>

<style>
  .contact__availability {
    margin-block-end: var(--space-l);
    font-size: var(--step-1);
  }

  .contact__list .subhead {
    margin-block-end: var(--space-2xs);
  }

  .contact__card {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-l);
    margin-block-start: var(--space-xl);
  }

  .contact__value {
    margin: 0;
    font-size: var(--step-1);
  }
</style>
