---
import { FOCUS_IDS } from '../../data/types';
import { getProfile, type Locale } from '../../lib/i18n';
import Text from '../Text.astro';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = getProfile(lang);
---

<ul class="focus" role="list">
  {
    FOCUS_IDS.map((id, index) => {
      const area = t.focus[id];
      return (
        <li class="focus__item" data-item={id}>
          {index === 0 && <slot name="label" />}
          <h3 class="focus__title">{area.title}</h3>
          {area.interest && (
            <p class="focus__tag">
              <span class="tag">{t.ui.researchInterest}</span>
            </p>
          )}
          <p>
            <Text value={area.text} />
          </p>
        </li>
      );
    })
  }
</ul>

<style>
  .focus {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-l) var(--grid-gap);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .focus__item {
    padding-block-start: var(--space-s);
    border-top: var(--rule);
  }

  .focus__item > * + * {
    margin-block-start: var(--space-xs);
  }

  .focus__title {
    font-size: var(--size-title);
    font-weight: 600;
    line-height: 1.25;
    color: var(--brand);
  }

  @media (width >= 64em) {
    .focus {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  /*
   * Stacked on paper whatever width the browser reports. The rule moves from
   * the item to its title, so the printed section heading in the first item
   * sits above it.
   */
  @media print {
    .focus {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-s);
    }

    .focus__item {
      padding-block-start: 0;
      border-top: 0;
    }

    .focus__title {
      padding-block-start: var(--space-s);
      border-top: var(--rule);
    }
  }
</style>
